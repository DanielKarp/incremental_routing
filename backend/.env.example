# Copy to backend/.env and fill in.

# Walk/bike routing provider: "ors", "valhalla" or "straight-line".
# Leave unset to use ORS when ORS_API_KEY is set, otherwise the public Valhalla server.
# ROUTING_PROVIDER=ors

# Free key from https://openrouteservice.org/dev/#/signup (2,000 directions requests/day).
ORS_API_KEY=

# Any Valhalla-compatible /route endpoint. The default is the public FOSSGIS server
# (fair use, no key). Stadia Maps works too: https://api.stadiamaps.com/route/v1 plus VALHALLA_API_KEY.
# VALHALLA_ROUTE_URL=https://valhalla1.openstreetmap.de/route
# VALHALLA_API_KEY=

# Transit data that ir-load-gtfs builds: "agencies" (the Caltrain, BART and VTA feeds, no key;
# the default) or "511" (the 511.org regional feed for every Bay Area operator).
# GTFS_SOURCE=511

# Free token from https://511.org/open-data/token. Needed only for GTFS_SOURCE=511.
API_511_KEY=

# Timezone used for request times that carry no UTC offset.
# DEFAULT_TIMEZONE=America/Los_Angeles

# Where downloaded feeds and gtfs.sqlite live (default: backend/data).
# IR_DATA_DIR=
