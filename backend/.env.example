# Copy to backend/.env and fill in.

# Walk/bike routing provider: "valhalla" (the default), "ors" or "straight-line" (offline).
# Valhalla's bike times allow for hills, and its bike routes come with heights for the profile.
# ROUTING_PROVIDER=valhalla

# Only for ROUTING_PROVIDER=ors. Free key from https://openrouteservice.org/dev/#/signup.
# ORS_API_KEY=

# Any Valhalla-compatible /route endpoint. The default is the public FOSSGIS server
# (fair use, no key). Stadia Maps works too: https://api.stadiamaps.com/route/v1 plus VALHALLA_API_KEY.
# VALHALLA_ROUTE_URL=https://valhalla1.openstreetmap.de/route
# VALHALLA_API_KEY=

# Free token from https://511.org/open-data/token. ir-load-gtfs needs it to download the
# transit schedules: 511.org's regional feed for every Bay Area operator.
API_511_KEY=

# Timezone used for request times that carry no UTC offset.
# DEFAULT_TIMEZONE=America/Los_Angeles

# Where downloaded feeds and gtfs.sqlite live (default: backend/data).
# IR_DATA_DIR=
