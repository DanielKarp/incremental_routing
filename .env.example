# Settings for Incremental Routing. Copy to .env (in this folder, the repository root) and fill
# in. Docker Compose and the backend both read it.

# Required: a free token from https://511.org/open-data/token. The app downloads the Bay Area's
# transit schedules (511.org's regional feed for every operator) with it.
API_511_KEY=

# --- Docker -----------------------------------------------------------------------------------
# Where the app listens on this machine (http://localhost:8000). BIND=0.0.0.0 also lets other
# devices on your network reach it.
# PORT=8000
# BIND=127.0.0.1
# How often to download fresh schedules, in days.
# REFRESH_DAYS=7
# To share the app through a Cloudflare tunnel (docker compose --profile tunnel up -d).
# TUNNEL_TOKEN=

# --- Walk and bike routing ----------------------------------------------------------------------
# "valhalla" (the default), "ors" or "straight-line" (offline estimates).
# Valhalla's bike times allow for hills, and its bike routes come with heights for the profile.
# ROUTING_PROVIDER=valhalla
# Any Valhalla-compatible /route endpoint. The default is the public FOSSGIS server (fair use,
# no key). Stadia Maps works too: https://api.stadiamaps.com/route/v1 plus VALHALLA_API_KEY.
# VALHALLA_ROUTE_URL=https://valhalla1.openstreetmap.de/route
# VALHALLA_API_KEY=
# Only for ROUTING_PROVIDER=ors. Free key from https://openrouteservice.org/dev/#/signup.
# ORS_API_KEY=

# --- Running without Docker ---------------------------------------------------------------------
# Timezone used for request times that carry no UTC offset.
# DEFAULT_TIMEZONE=America/Los_Angeles
# Where downloaded feeds and gtfs.sqlite live (default: backend/data).
# IR_DATA_DIR=
