// The site on Cloudflare: the built app (dist/, with the timetable in dist/data/) as a Worker's
// static assets, with no Worker code. Every request is for a file; walk and bike routes come
// from the routing server the browser asks itself (DEPLOY.md).
//
//   npm run preview   builds, then serves it locally with `wrangler dev` (http://localhost:8787)
//   npm run deploy    builds, then `wrangler deploy` (`npx wrangler login` first, once)
//
// Build the timetable before either: `cd ../builder && uv run ir-build-data`. public/_headers
// sets how long browsers keep each file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incremental-routing",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // A path without a file is a 404, as it was with the server: a file missing from data/
    // above all, so the app can say there's no timetable rather than read the page as one.
    // The app is at /, and reads its state from the browser, not the URL.
    "not_found_handling": "none"
  }
  // To serve the site on your own domain (one on Cloudflare): in the dashboard, Workers & Pages
  // > incremental-routing > Settings > Domains & Routes > Add > Custom domain. Or here, and
  // `npm run deploy` adds it:
  // "routes": [{ "pattern": "trips.example.com", "custom_domain": true }]
}
