// The site on Cloudflare: the built app (dist/, with the timetable in dist/data/) as static
// assets, and one Worker (worker/index.ts) for walk and bike routes under /api/*.
//
//   npm run preview   builds, then runs it all locally with `wrangler dev` (http://localhost:8787)
//   npm run deploy    builds, then `wrangler deploy` (`npx wrangler login` first, once)
//
// Build the timetable before either: `cd ../backend && uv run ir-build-data`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incremental-routing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Any page path gets the app, which reads its state from the browser, not the URL.
    "not_found_handling": "single-page-application",
    // Everything else is served without running the Worker (public/_headers sets the caching).
    "run_worker_first": ["/api/*"]
  },
  // Walk and bike routing, as the server's settings were (see worker/routing.ts): "valhalla",
  // "ors" or "straight-line" (offline estimates). Valhalla's bike times allow for hills, and its
  // bike routes come with heights for the profile. Any Valhalla-compatible /route endpoint will
  // do; the default is the public FOSSGIS server (fair use, no key). Stadia Maps works too:
  // https://api.stadiamaps.com/route/v1, with its key as the secret VALHALLA_API_KEY.
  //
  // Keys are secrets, never vars: `npx wrangler secret put VALHALLA_API_KEY` (or ORS_API_KEY,
  // for ROUTING_PROVIDER "ors"; free from https://openrouteservice.org/dev/#/signup). For
  // `npm run dev` and `npm run preview`, put them in .dev.vars here instead (never committed):
  // VALHALLA_API_KEY=...
  "vars": {
    "ROUTING_PROVIDER": "valhalla",
    "VALHALLA_ROUTE_URL": "https://valhalla1.openstreetmap.de/route"
  }
  // To serve the site on your own domain (one on Cloudflare): in the dashboard, Workers & Pages
  // > incremental-routing > Settings > Domains & Routes > Add > Custom domain. Or here, and
  // `npm run deploy` adds it:
  // "routes": [{ "pattern": "trips.example.com", "custom_domain": true }]
}
