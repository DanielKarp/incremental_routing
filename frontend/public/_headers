# How long browsers keep the site's files (Cloudflare reads this from dist/; see wrangler.jsonc).
# Anything not named here is checked for changes each time it's used.

# The manifest names the newest timetable, so it is always checked for a newer one.
/data/manifest.json
  Cache-Control: no-cache

# The timetable's name changes with its contents, as do the names of Vite's built files.
/data/timetable-*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
